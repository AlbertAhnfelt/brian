{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Top level = local development (`pnpm dev`). `env.dev` and `env.prod` are the deployed
	// environments: `wrangler deploy --env dev|prod`. Bindings are NOT inherited by environments.
	"name": "brian-web",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	"workers_dev": false,
	"preview_urls": false,

	// "true" limits sign-in to the ALLOWED_EMAILS secret (comma-separated). Only dev is restricted.
	"vars": { "RESTRICT_LOGIN": "false" },

	// Shared with apps/server, which owns the schema.
	"d1_databases": [{ "binding": "DB", "database_name": "brian-local", "database_id": "local-brian-db" }],
	// Account management RPC on apps/server (connected apps, export, deletion).
	"services": [{ "binding": "SERVER", "service": "brian-server", "entrypoint": "Account" }],

	"env": {
		"dev": {
			// Everything on the host goes here, except the OAuth/MCP paths routed to brian-server-dev.
			"vars": { "RESTRICT_LOGIN": "true" },
			"routes": [{ "pattern": "dev.mybrian.dev/*", "zone_name": "mybrian.dev" }],
			"d1_databases": [{ "binding": "DB", "database_name": "brian-dev", "database_id": "37a7eb4b-b045-4159-9ba9-593c9b2ea89e" }],
			"services": [{ "binding": "SERVER", "service": "brian-server-dev", "entrypoint": "Account" }]
		},
		"prod": {
			"vars": { "RESTRICT_LOGIN": "false" },
			"routes": [{ "pattern": "mybrian.dev/*", "zone_name": "mybrian.dev" }],
			"d1_databases": [{ "binding": "DB", "database_name": "brian-prod", "database_id": "a4b58792-379a-4b21-af46-ef942f5fd762" }],
			"services": [{ "binding": "SERVER", "service": "brian-server-prod", "entrypoint": "Account" }]
		}
	}
}
